# Copie este arquivo para .env.local e preencha com seus próprios valores.
# NUNCA versione .env.local e NUNCA use o prefixo NEXT_PUBLIC_ nestas variáveis (são segredos de servidor).
# Os valores abaixo são apenas exemplos fictícios.

# --- NeonDB (apenas servidor) ---
# Neon Console -> Connection Details -> use a string do pooler (host com "-pooler")
DATABASE_URL=postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/NOME_DO_BANCO?sslmode=require

# --- Armazenamento de arquivos (Vercel Blob) ---
# Criado ao conectar um Blob store ao projeto na Vercel (Storage -> Blob). Uploads de capas, galeria e PDFs.
BLOB_READ_WRITE_TOKEN=seu_token_do_vercel_blob

# --- Painel /admin ---
# Sem valor padrão: se faltar, o login falha.
ADMIN_PASSWORD=defina_uma_senha_forte
# Segredo que assina o cookie de sessão do admin. MÍNIMO 32 caracteres. Gere com: openssl rand -base64 48
SESSION_SECRET=gere_um_valor_aleatorio_com_pelo_menos_32_caracteres

# --- Origens permitidas para operações de escrita (opcional) ---
# Escritas (admin e emissão de tokens de upload) exigem o cabeçalho Origin permitido.
# Na Vercel, o endereço do deploy (VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL) é aceito automaticamente.
# Com DOMÍNIO PRÓPRIO, liste aqui as origens exatas, separadas por vírgula (com https://, sem barra final).
# "www.meusite.com.br" e "meusite.com.br" são origens diferentes: inclua as duas se usar ambas.
# ALLOWED_ORIGINS=https://www.meusite.com.br,https://meusite.com.br

# --- Formulário de contato (Resend) ---
# Em produção, sem estas duas variáveis o contato responde "serviço indisponível".
# Observação: o remetente padrão (onboarding@resend.dev) só entrega para o e-mail dono da conta Resend;
# para outros destinos, verifique um domínio no Resend.
RESEND_API_KEY=sua_chave_resend
CONTACT_EMAIL=seu@email.com
